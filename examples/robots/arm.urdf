<?xml version="1.0"?>
<!-- A three-joint arm with a gripper, written the way a real URDF is written: primitives for
     the visuals, fixed-axis rpy origins, and joint limits that mean something. Point
     `ferroscope urdf` at your own file instead; this one exists so the verb has a subject. -->
<robot name="bench_arm">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.09" length="0.05"/></geometry>
      <material name="dark"><color rgba="0.20 0.26 0.42 1"/></material>
    </visual>
  </link>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      <material name="gold"><color rgba="0.81 0.67 0.36 1"/></material>
    </visual>
  </link>

  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.07 0.07 0.28"/></geometry>
      <material name="steel"><color rgba="0.54 0.63 0.74 1"/></material>
    </visual>
  </link>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.105"/>
      <geometry><box size="0.055 0.055 0.21"/></geometry>
      <material name="teal"><color rgba="0.27 0.78 0.69 1"/></material>
    </visual>
  </link>

  <link name="gripper">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.05 0.09 0.06"/></geometry>
      <material name="violet"><color rgba="0.62 0.55 1.0 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.035 0.075"/>
      <geometry><box size="0.02 0.02 0.05"/></geometry>
      <material name="violet"><color rgba="0.62 0.55 1.0 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.035 0.075"/>
      <geometry><box size="0.02 0.02 0.05"/></geometry>
      <material name="violet"><color rgba="0.62 0.55 1.0 1"/></material>
    </visual>
  </link>

  <joint name="yaw" type="revolute">
    <parent link="base"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="20" velocity="2.5"/>
  </joint>

  <joint name="shoulder" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.10"/><axis xyz="0 1 0"/>
    <limit lower="-1.1" upper="1.1" effort="18" velocity="2.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.28"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="0.2" effort="12" velocity="2.0"/>
  </joint>

  <joint name="wrist" type="revolute">
    <parent link="forearm"/><child link="gripper"/>
    <origin xyz="0 0 0.21"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="6" velocity="3.0"/>
  </joint>
</robot>
